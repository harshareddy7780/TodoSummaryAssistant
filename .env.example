
# ==========================================
# Local development environment
# Copy this file to .env and fill in values.
# Never commit .env or real credentials.
# ==========================================

# MySQL (local Docker Compose)
MYSQL_ROOT_PASSWORD=replace_with_a_strong_local_root_password
MYSQL_PASSWORD=replace_with_a_strong_local_db_password

# Spring Boot backend
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/todo_db
SPRING_DATASOURCE_USERNAME=todo_user
SPRING_DATASOURCE_PASSWORD=replace_with_a_strong_local_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SERVER_PORT=8081

# External integrations (optional for local development)
COHERE_API_KEY=
SLACK_WEBHOOK_URL=

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8081/api

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_grafana_password
